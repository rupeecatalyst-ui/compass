{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=4096 NEXT_TELEMETRY_DISABLED=1 npm run build",
  "crons": [
    {
      "path": "/api/cron/enterprise-metrics",
      "schedule": "30 20 * * *"
    }
  ]
}
