{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "node --max-old-space-size=6144 ./node_modules/next/dist/bin/next build",
  "crons": [
    {
      "path": "/api/cron/enterprise-metrics",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/cron/post-disbursement-confirmation",
      "schedule": "40 20 * * *"
    }
  ]
}
