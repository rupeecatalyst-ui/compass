model EnterpriseOpportunity {
  id                        String                      @id @default(cuid())
  organizationId            String                      @map("organization_id")
  opportunityNumber         String                      @map("opportunity_number")
  /**
   * CO-ARCH-002 — Retired bridge key only (not a Loan File entity FK).
   * Historical Soft Go-Live continuity. Do not treat as business SSOT.
   * Canonical identity: Opportunity / Deal ids.
   */
  legacyLoanFileId          String?                     @map("legacy_loan_file_id")
  externalRefs              Json?                       @map("external_refs")
  productId                 String?                     @map("product_id")
  productCode               String?                     @map("product_code")
  productLabel              String?                     @map("product_label")
  /// CO-ARCH — Contact+Product uniqueness key (normalized). Partial unique while planning-active.
  productUniquenessKey      String?                     @map("product_uniqueness_key")
  productFamily             DealProductFamily           @map("product_family")
  transactionType           String?                     @map("transaction_type")
  /// BI-4 — requirement readiness only (never lender pipeline)
  requirementStage          String                      @map("requirement_stage")
  requirementSubStage       String?                     @map("requirement_sub_stage")
  lifecycleStatus           OpportunityLifecycleStatus  @default(active) @map("lifecycle_status")
  fulfilmentMode            OpportunityFulfilmentMode   @default(exclusive) @map("fulfilment_mode")
  fulfilmentStatus          OpportunityFulfilmentStatus @default(open) @map("fulfilment_status")
  fulfilledAmount           Decimal                     @default(0) @map("fulfilled_amount") @db.Decimal(18, 2)
  stageEnteredAt            DateTime                    @map("stage_entered_at")
  closedAt                  DateTime?                   @map("closed_at")
  archived                  Boolean                     @default(false)
  archivedAt                DateTime?                   @map("archived_at")
  archivedBy                String?                     @map("archived_by")
  primaryOwnerUserId        String?                     @map("primary_owner_user_id")
  relationshipManagerUserId String?                     @map("relationship_manager_user_id")
  relationshipManagerName   String?                     @map("relationship_manager_name")
  teamId                    String?                     @map("team_id")
  branchId                  String?                     @map("branch_id")
  /// CO-DOM-001 — null when primary borrower is a Company.
  primaryContactId          String?                     @map("primary_contact_id")
  primaryContactName        String?                     @map("primary_contact_name")
  primaryContactMobile      String?                     @map("primary_contact_mobile")
  primaryContactEmail       String?                     @map("primary_contact_email")
  /// CO-DOM-001 — individual (default) or company primary borrower.
  primaryBorrowerKind       OpportunityPrimaryBorrowerKind @default(individual) @map("primary_borrower_kind")
  companyId                 String?                     @map("company_id")
  /// Denormalized company name when company is primary borrower.
  companyName               String?                     @map("company_name")
  employmentTypeCode        String?                     @map("employment_type_code")
  cityLabel                 String?                     @map("city_label")
  stateLabel                String?                     @map("state_label")
  currencyCode              String                      @default("INR") @map("currency_code")
  requestedAmount           Decimal?                    @map("requested_amount") @db.Decimal(18, 2)
  priority                  DealPriority                @default(medium)
  sourceCode                String?                     @map("source_code")
  sourceContactId           String?                     @map("source_contact_id")
  /// Denormalized Source Contact display name (analytics / MIS / commissions).
  sourceContactName         String?                     @map("source_contact_name")
  /// CO-OPP-003 — Wealth Partner Registry id when Business Source = Wealth Partner.
  sourceWealthPartnerId     String?                     @map("source_wealth_partner_id")
  /// CO-OPP-003 — referral | sole_executor | joint_executor (Wealth Partner only).
  participationRole         String?                     @map("participation_role")
  /// CO-OPP-003 — snapshot % of RC revenue from Commercial Profile (auto-resolved).
  commercialRevenueSharePercent Float?                  @map("commercial_revenue_share_percent")
  /// CO-OPP-003 — Marketing campaign label (future-ready).
  sourceCampaignLabel       String?                     @map("source_campaign_label")
  snapshot                  Json?
  lendingExtension          Json?                       @map("lending_extension")
  versionNumber             Int                         @default(1) @map("version_number")
  rowVersion                Int                         @default(1) @map("row_version")
  createdBy                 String?                     @map("created_by")
  updatedBy                 String?                     @map("updated_by")
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  isDeleted                 Boolean                     @default(false) @map("is_deleted")
  deletedAt                 DateTime?                   @map("deleted_at")
  deletedBy                 String?                     @map("deleted_by")
  deletionReason            String?                     @map("deletion_reason") @db.Text

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryContact EcmContact?        @relation("EnterpriseOpportunityPrimaryContact", fields: [primaryContactId], references: [id], onDelete: Restrict)
  company        EcmCompany?        @relation("EnterpriseOpportunityCompany", fields: [companyId], references: [id], onDelete: Restrict)
  product        EnterpriseProduct? @relation(fields: [productId], references: [id], onDelete: Restrict)
  deals          EnterpriseDeal[]

  @@unique([organizationId, opportunityNumber], map: "eopp_org_number_key")
  @@unique([organizationId, legacyLoanFileId], map: "eopp_org_legacy_loan_file_key")
  @@index([organizationId, isDeleted, archived, updatedAt(sort: Desc)], map: "eopp_org_list_idx")
  @@index([organizationId, primaryContactId], map: "eopp_org_contact_idx")
  @@index([organizationId, productFamily, requirementStage], map: "eopp_org_family_stage_idx")
  @@index([organizationId, relationshipManagerUserId], map: "eopp_org_rm_idx")
  @@index([organizationId, lifecycleStatus, fulfilmentStatus], map: "eopp_org_status_idx")
  @@index([organizationId, productId], map: "eopp_org_product_idx")
  @@index([organizationId, primaryContactId, productUniquenessKey, lifecycleStatus], map: "eopp_org_contact_product_lifecycle_idx")
  @@index([organizationId, companyId, productUniquenessKey, lifecycleStatus], map: "eopp_org_company_product_lifecycle_idx")
  @@index([organizationId, sourceCode, isDeleted], map: "eopp_org_source_idx")
  @@index([organizationId, sourceWealthPartnerId], map: "eopp_org_source_wp_idx")
  @@index([organizationId, participationRole], map: "eopp_org_participation_idx")
  @@map("enterprise_opportunities")
}

/// CO-ARCH-003 Phase 2B Sprint 1 — Accounting Invoice Party Master
/// Entity against whom RC raises commission invoice for a Deal (not disbursement beneficiary).
/// Maintained only in Accounting → Invoice Party Master. Deal Workspace reads this list only.
/// DB table retained as enterprise_accounting_payees for Sprint 1 backward compatibility.
model EnterpriseInvoiceParty {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  /// Exactly one of contactId / companyId required (1 : 0..1 Contact/Company → Master)
  contactId        String?  @map("contact_id")
  companyId        String?  @map("company_id")
  /// customer | lender | builder | channel_partner | chartered_accountant | direct_corporate | intermediary | other
  partyType        String   @map("payee_type")
  legalName        String   @map("legal_name")
  billingName      String   @map("billing_name")
  displayName      String   @map("display_name")
  gstin            String?
  pan              String?
  billingAddress   String?  @map("billing_address") @db.Text
  stateLabel       String?  @map("state_label")
  invoiceEmail     String?  @map("invoice_email")
  tdsApplicable    Boolean  @default(false) @map("tds_applicable")
  tdsRatePercent   Float?   @map("tds_rate_percent")
  /// registered | unregistered | composition | unknown
  gstStatus        String?  @map("gst_status")
  specify          String?
  notes            String?  @db.Text
  /// Active / Inactive
  enabled          Boolean  @default(true)
  createdBy        String?  @map("created_by")
  updatedBy        String?  @map("updated_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  isDeleted        Boolean  @default(false) @map("is_deleted")
  deletedAt        DateTime? @map("deleted_at")
  deletedBy        String?  @map("deleted_by")
  deletionReason   String?  @map("deletion_reason") @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contact      EcmContact?  @relation("InvoicePartyContact", fields: [contactId], references: [id], onDelete: Restrict)
  company      EcmCompany?  @relation("InvoicePartyCompany", fields: [companyId], references: [id], onDelete: Restrict)
  deals        EnterpriseDeal[] @relation("DealInvoiceParty")
  accountingInvoices EnterpriseAccountingInvoice[]

  @@index([organizationId, isDeleted, enabled], map: "eapayee_org_active_idx")
  @@index([organizationId, isDeleted, partyType], map: "eapayee_org_type_idx")
  @@index([organizationId, contactId], map: "eapayee_org_contact_idx")
  @@index([organizationId, companyId], map: "eapayee_org_company_idx")
  @@index([organizationId, updatedAt(sort: Desc)], map: "eapayee_org_updated_idx")
  @@map("enterprise_accounting_payees")
}

