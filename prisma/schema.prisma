model EnterpriseLender {
  id                    String                    @id @default(cuid())
  organizationId        String                    @map("organization_id")
  categoryId            String                    @map("category_id")
  /// Immutable enterprise identifier (LND000001…). Never rename after issue.
  code                  String
  label                 String
  /// Official legal name (e.g. HDFC Bank Limited).
  legalName             String?                   @map("legal_name")
  /// Operator-facing display name (defaults to label when null).
  displayName           String?                   @map("display_name")
  shortName             String?                   @map("short_name")
  /// Alternate names used for duplicate detection / search (JSON string[]).
  aliases               Json?
  description           String?                   @db.Text
  institutionCategory   LenderInstitutionCategory @map("institution_category")
  /// CO-ARCH-004 master classification (PSB / Private / SFB / HFC / NBFC / Coop / Payments).
  classification        LenderMasterClassification? @map("classification")
  lifecycleStatus       LenderLifecycleStatus     @default(draft) @map("lifecycle_status")
  operationalStatus     LenderOperationalStatus   @default(inactive) @map("operational_status")
  countryReferenceId    String?                   @map("country_reference_id")
  stateReferenceId      String?                   @map("state_reference_id")
  cityReferenceId       String?                   @map("city_reference_id")
  headquartersLabel     String?                   @map("headquarters_label")
  website               String?
  logoUrl               String?                   @map("logo_url")
  rbiRegistrationNumber String?                   @map("rbi_registration_number")
  rbiRegulated          Boolean                   @default(true) @map("rbi_regulated")
  customerCarePhone     String?                   @map("customer_care_phone")
  customerCareEmail     String?                   @map("customer_care_email")
  panIndia              Boolean                   @default(false) @map("pan_india")
  coverageStates        Json?                     @map("coverage_states")
  coverageCities        Json?                     @map("coverage_cities")
  productsSupported     Json?                     @map("products_supported")
  tags                  Json?
  sortOrder             Int                       @default(0) @map("sort_order")
  /// CO-ADMIN-005 — business priority (lower = higher priority in matching)
  priority              Int                       @default(50)
  /// Default processing rules pack (JSON object — TAT, fee defaults, login prefs)
  defaultProcessingRules Json?                    @map("default_processing_rules")
  /// Branch / location coverage labels beyond state/city masters
  branchCoverage        Json?                     @map("branch_coverage")
  /// RM mapping entries [{ name, mobile?, email?, userId?, branch? }]
  rmMapping             Json?                     @map("rm_mapping")
  remarks               String?                   @db.Text
  status                RegistryStatus            @default(draft)
  enabled               Boolean                   @default(true)
  versionNumber         Int                       @default(1) @map("version_number")
  effectiveFrom         DateTime?                 @map("effective_from")
  effectiveUntil        DateTime?                 @map("effective_until")
  notes                 String?                   @db.Text
  isDeleted             Boolean                   @default(false) @map("is_deleted")
  deletedAt             DateTime?                 @map("deleted_at")
  deletedBy             String?                   @map("deleted_by")
  deletionReason        String?                   @map("deletion_reason") @db.Text
  approvalStatus        RegistryApprovalStatus    @default(none) @map("approval_status")
  approvedBy            String?                   @map("approved_by")
  approvedAt            DateTime?                 @map("approved_at")
  createdBy             String                    @map("created_by")
  modifiedBy            String                    @map("modified_by")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     EnterpriseLenderCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  programs     EnterpriseLenderProgram[]
  contacts     EnterpriseLenderContact[]
  documents    EnterpriseLenderDocument[]
  deals        EnterpriseDeal[]
  /// CO-LEND-001
  programPortalInvites LenderProgramPortalInvite[]
  programSubmissions   LenderProgramSubmission[]

  @@unique([organizationId, code], map: "elend_org_code_key")
  @@index([organizationId, categoryId, status, enabled], map: "elend_org_cat_status_idx")
  @@index([organizationId, lifecycleStatus, operationalStatus], map: "elend_org_lifecycle_ops_idx")
  @@index([organizationId, isDeleted], map: "elend_org_deleted_idx")
  @@map("enterprise_lenders")
}

