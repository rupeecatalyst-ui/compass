/// Durable billed invoice SSOT. Raised only by Accounting Raise Invoice — never on Disbursed or Confirmation Received.
model EnterpriseAccountingInvoice {
  id                     String   @id @default(cuid())
  organizationId         String   @map("organization_id")
  accountingCaseId       String   @map("accounting_case_id")
  dealId                 String   @map("deal_id")
  opportunityId          String?  @map("opportunity_id")
  invoicePartyId         String   @map("invoice_party_id")
  gstRateId              String   @map("gst_rate_id")

  productId              String?  @map("product_id")
  productCode            String?  @map("product_code")
  productLabel           String?  @map("product_label")
  productFamily          String   @map("product_family")
  invoiceProductPrefix   String   @map("invoice_product_prefix")

  financialYearKey       String   @map("financial_year_key")
  sequenceNumber         Int      @map("sequence_number")
  invoiceNumber          String   @map("invoice_number")

  invoiceDate            DateTime @map("invoice_date")
  dueDate                DateTime? @map("due_date")
  confirmationReference  String   @map("confirmation_reference")

  partyBillingName       String   @map("party_billing_name")
  partyGstin             String?  @map("party_gstin")
  partyPan               String?  @map("party_pan")
  partyBillingAddress    String?  @map("party_billing_address") @db.Text
  partyStateLabel        String?  @map("party_state_label")
  partyGstStatus         String?  @map("party_gst_status")
  partyTdsApplicable     Boolean  @map("party_tds_applicable")
  partyTdsRatePercent    Float?   @map("party_tds_rate_percent")
  partyDisplayName       String   @map("party_display_name")

  taxableValue           Decimal  @map("taxable_value") @db.Decimal(18, 2)
  gstRatePercent         Decimal  @map("gst_rate_percent") @db.Decimal(9, 4)
  gstAmount              Decimal  @map("gst_amount") @db.Decimal(18, 2)
  invoiceTotal           Decimal  @map("invoice_total") @db.Decimal(18, 2)
  tdsRatePercent         Decimal? @map("tds_rate_percent") @db.Decimal(9, 4)
  tdsAmount              Decimal  @map("tds_amount") @db.Decimal(18, 2)
  netReceivable          Decimal  @map("net_receivable") @db.Decimal(18, 2)

  /// draft | raised | shared | cancelled — Phase 1 Raise creates raised
  documentStatus         String   @map("document_status")

  raisedBy               String   @map("raised_by")
  raisedAt               DateTime @map("raised_at")
  cancelledAt            DateTime? @map("cancelled_at")
  cancelledBy            String?  @map("cancelled_by")
  cancellationReason     String?  @map("cancellation_reason") @db.Text
  rowVersion             Int      @default(1) @map("row_version")
  createdBy              String   @map("created_by")
  updatedBy              String   @map("updated_by")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  accountingCase EnterpriseAccountingCase   @relation(fields: [accountingCaseId], references: [id], onDelete: Restrict)
  deal           EnterpriseDeal             @relation(fields: [dealId], references: [id], onDelete: Restrict)
  invoiceParty   EnterpriseInvoiceParty     @relation(fields: [invoicePartyId], references: [id], onDelete: Restrict)
  gstRate        EnterpriseAccountingGstRate @relation(fields: [gstRateId], references: [id], onDelete: Restrict)
  payments       EnterpriseAccountingPayment[]
  creditNotes    EnterpriseAccountingCreditNote[]

  @@unique([organizationId, invoiceNumber], map: "eainv_org_number_key")
  @@index([organizationId, documentStatus, invoiceDate(sort: Desc)], map: "eainv_org_status_date_idx")
  @@index([organizationId, accountingCaseId], map: "eainv_org_case_idx")
  @@index([dealId], map: "eainv_deal_idx")
  @@map("enterprise_accounting_invoices")
}

/// Money actually received against an Invoice. Not a receivable ledger. Draft/voided do not affect outstanding.
