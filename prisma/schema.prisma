// ─── CO-LEND-001 — Lender Self-Service Program Management Portal ─────────────

enum LenderProgramPortalInviteStatus {
  active
  revoked
  expired
}

enum LenderProgramSubmissionStatus {
  draft
  pending_review
  clarification_requested
  rejected
  approved
  published
  scheduled
}

/// Secure, revocable invite token for lender program self-service.
model LenderProgramPortalInvite {
  id             String                         @id @default(cuid())
  organizationId String                         @map("organization_id")
  lenderId       String                         @map("lender_id")
  /// Public token (random). Never log full token after issue.
  token          String                         @unique
  status         LenderProgramPortalInviteStatus @default(active)
  expiresAt      DateTime                       @map("expires_at")
  revokedAt      DateTime?                      @map("revoked_at")
  revokedBy      String?                        @map("revoked_by")
  revokeReason   String?                        @map("revoke_reason") @db.Text
  maxUses        Int?                           @map("max_uses")
  useCount       Int                            @default(0) @map("use_count")
  /// Dual OTP — email channel (hashed)
  emailOtpHash        String?   @map("email_otp_hash")
  emailOtpExpiresAt   DateTime? @map("email_otp_expires_at")
  emailOtpVerifiedAt  DateTime? @map("email_otp_verified_at")
  /// Dual OTP — mobile channel (hashed)
  mobileOtpHash       String?   @map("mobile_otp_hash")
  mobileOtpExpiresAt  DateTime? @map("mobile_otp_expires_at")
  mobileOtpVerifiedAt DateTime? @map("mobile_otp_verified_at")
  /// Both channels verified (gate for submit)
  otpVerifiedAt  DateTime?                      @map("otp_verified_at")
  /// Pending verifier identity captured at OTP request
  pendingVerifier Json?                         @map("pending_verifier")
  /// Legacy single-OTP columns (kept for migration compatibility)
  otpHash        String?                        @map("otp_hash")
  otpExpiresAt   DateTime?                      @map("otp_expires_at")
  createdBy      String                         @map("created_by")
  notes          String?                        @db.Text
  createdAt      DateTime                       @default(now()) @map("created_at")
  updatedAt      DateTime                       @updatedAt @map("updated_at")

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lender       EnterpriseLender          @relation(fields: [lenderId], references: [id], onDelete: Restrict)
  submissions  LenderProgramSubmission[]

  @@index([organizationId, lenderId, status], map: "lpp_invite_org_lender_status_idx")
  @@index([organizationId, expiresAt], map: "lpp_invite_org_expires_idx")
  @@map("lender_program_portal_invites")
}

/// Staging submission — never writes live EnterpriseLenderProgram until admin publish.
model LenderProgramSubmission {
  id                   String                        @id @default(cuid())
  organizationId       String                        @map("organization_id")
  inviteId             String                        @map("invite_id")
  lenderId             String                        @map("lender_id")
  productCode          String                        @map("product_code")
  productId            String?                       @map("product_id")
  templateKey          String                        @map("template_key")
  programName          String                        @map("program_name")
  status               LenderProgramSubmissionStatus @default(draft)
  /// Verifier identity captured after OTP
  verifierName         String?                       @map("verifier_name")
  verifierEmployeeId   String?                       @map("verifier_employee_id")
  verifierEmail        String?                       @map("verifier_email")
  verifierMobile       String?                       @map("verifier_mobile")
  verifierDesignation  String?                       @map("verifier_designation")
  verifierBranch       String?                       @map("verifier_branch")
  verifierRegion       String?                       @map("verifier_region")
  /// CO-LEND-001B — Contact Directory + Dialogue attribution
  ecmContactId         String?                       @map("ecm_contact_id")
  dialogueThreadId     String?                       @map("dialogue_thread_id")
  emailVerifiedAt      DateTime?                     @map("email_verified_at")
  mobileVerifiedAt     DateTime?                     @map("mobile_verified_at")
  approvedAt           DateTime?                     @map("approved_at")
  /// Proposed program fields (product-template shaped JSON)
  proposedPayload      Json                          @map("proposed_payload")
  /// Snapshot of current published program at submit (for comparison)
  currentSnapshot      Json?                         @map("current_snapshot")
  /// Document registry record ids / metadata
  documentLinks        Json?                         @map("document_links")
  versionNumber        Int                           @default(1) @map("version_number")
  previousProgramId    String?                       @map("previous_program_id")
  publishedProgramId   String?                       @map("published_program_id")
  submittedAt          DateTime?                     @map("submitted_at")
  reviewedBy           String?                       @map("reviewed_by")
  reviewedAt           DateTime?                     @map("reviewed_at")
  publishedBy          String?                       @map("published_by")
  publishedAt          DateTime?                     @map("published_at")
  schedulePublishAt    DateTime?                     @map("schedule_publish_at")
  adminComments        String?                       @map("admin_comments") @db.Text
  clarificationNotes   String?                       @map("clarification_notes") @db.Text
  rejectionReason      String?                       @map("rejection_reason") @db.Text
  ipAddress            String?                       @map("ip_address")
  createdAt            DateTime                      @default(now()) @map("created_at")
  updatedAt            DateTime                      @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invite       LenderProgramPortalInvite @relation(fields: [inviteId], references: [id], onDelete: Restrict)
  lender       EnterpriseLender         @relation(fields: [lenderId], references: [id], onDelete: Restrict)
  dialogueThread LenderProgramDialogueThread? @relation(fields: [dialogueThreadId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, submittedAt], map: "lpp_sub_org_status_submitted_idx")
  @@index([organizationId, lenderId, productCode], map: "lpp_sub_org_lender_product_idx")
  @@index([organizationId, inviteId], map: "lpp_sub_org_invite_idx")
  @@index([organizationId, ecmContactId], map: "lpp_sub_org_contact_idx")
  @@index([organizationId, dialogueThreadId], map: "lpp_sub_org_dialogue_idx")
  @@map("lender_program_submissions")
}

