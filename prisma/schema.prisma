  lenderId           String?   @map("lender_id")
  documentScope      String    @default("applicant") @map("document_scope")
  typeRef            String    @map("type_ref")
  categoryLabel      String    @map("category_label")
  originalFilename   String    @map("original_filename")
  displayName        String    @map("display_name")
  mimeType           String    @map("mime_type")
  fileSizeBytes      Int       @map("file_size_bytes")
  status             String    @default("active")
  uploadSource       String?   @map("upload_source")
  uploadedBy         String    @map("uploaded_by")
  verifiedAt         DateTime? @map("verified_at")
  verifiedBy         String?   @map("verified_by")
  /// Optional binary (capped by API). Null = metadata-only (blob may be client-local).
  contentBytes       Bytes?    @map("content_bytes")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, clientRecordId], map: "etd_org_client_record_key")
  @@index([organizationId, opportunityId, status], map: "etd_org_opp_status_idx")
  @@index([organizationId, contactId], map: "etd_org_contact_idx")
  @@map("enterprise_transaction_documents")
}

// =============================================================================
// CO-WP-001 — Enterprise Wealth Partner Registry
// Additive module. Contact / Company remain master identity SSOTs.
// Identity IDs stored without Prisma relations on ECM models (zero ECM schema churn).
// =============================================================================

enum WealthPartnerLifecycleStatus {
  draft
  onboarding
  active
  suspended
  retired
}

enum WealthPartnerOperationalStatus {
  inactive
  active
  restricted
}

enum WealthPartnerIdentityKind {
  contact
  company
}

enum WealthPartnerNetworkMemberStatus {
  active
  inactive
  ended
}

enum WealthPartnerCommissionPayoutFrequency {
  monthly
  quarterly
  half_yearly
  annually
  on_disbursement
  other
}

/// Immutable codes e.g. WPT000001. Business relationship on top of Contact or Company.
model EnterpriseWealthPartner {
  id                String                         @id @default(cuid())
  organizationId    String                         @map("organization_id")
  code              String
  displayName       String                         @map("display_name")
  /// Wealth Partner Type (business relationship) — not profession.
  partnerType       String                         @map("partner_type")
  identityKind      WealthPartnerIdentityKind      @map("identity_kind")
  /// Exactly one of contactId / companyId required (application-enforced).
  contactId         String?                        @map("contact_id")
  companyId         String?                        @map("company_id")
  identityLabel     String?                        @map("identity_label")
  lifecycleStatus   WealthPartnerLifecycleStatus   @default(onboarding) @map("lifecycle_status")
  operationalStatus WealthPartnerOperationalStatus @default(active) @map("operational_status")
  pan               String?
  gstin             String?
  email             String?
  mobile            String?
  cityLabel         String?                        @map("city_label")
  stateLabel        String?                        @map("state_label")
  website           String?
  notes             String?                        @db.Text
  profileJson       Json?                          @map("profile_json")
  complianceJson    Json?                          @map("compliance_json")
  /// CO-OPP-003 — Commercial Profile (% of Rupee Catalyst revenue by Participation Role).
  commercialReferralSharePercent       Float?      @map("commercial_referral_share_percent")
  commercialSoleExecutorSharePercent   Float?      @map("commercial_sole_executor_share_percent")
  commercialJointExecutorSharePercent  Float?      @map("commercial_joint_executor_share_percent")
  commercialEffectiveFrom              DateTime?   @map("commercial_effective_from")
  commercialStatus                     String      @default("active") @map("commercial_status")
  sortOrder         Int                            @default(0) @map("sort_order")
  status            RegistryStatus                 @default(active)
  enabled           Boolean                        @default(true)
  versionNumber     Int                            @default(1) @map("version_number")
  effectiveFrom     DateTime?                      @map("effective_from")
  effectiveUntil    DateTime?                      @map("effective_until")
  isDeleted         Boolean                        @default(false) @map("is_deleted")
  deletedAt         DateTime?                      @map("deleted_at")
  deletedBy         String?                        @map("deleted_by")
  deletionReason    String?                        @map("deletion_reason") @db.Text
  approvalStatus    RegistryApprovalStatus         @default(none) @map("approval_status")
  approvedBy        String?                        @map("approved_by")
  approvedAt        DateTime?                      @map("approved_at")
  createdBy         String                         @map("created_by")
  modifiedBy        String                         @map("modified_by")
  createdAt         DateTime                       @default(now()) @map("created_at")
  updatedAt         DateTime                       @updatedAt @map("updated_at")

  organization   Organization                          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  networkMembers EnterpriseWealthPartnerNetworkMember[]
  commissions    EnterpriseWealthPartnerCommission[]
  bankAccounts   EnterpriseWealthPartnerBankAccount[]
  activities     EnterpriseWealthPartnerActivity[]

  @@unique([organizationId, code], map: "ewp_org_code_key")
  @@index([organizationId, partnerType, isDeleted], map: "ewp_org_type_idx")
  @@index([organizationId, contactId], map: "ewp_org_contact_idx")
  @@index([organizationId, companyId], map: "ewp_org_company_idx")
  @@index([organizationId, isDeleted, updatedAt(sort: Desc)], map: "ewp_org_list_idx")
  @@map("enterprise_wealth_partners")
}

/// Network relationship only — never duplicates Contact/Company masters.
model EnterpriseWealthPartnerNetworkMember {
  id                 String                         @id @default(cuid())
  organizationId     String                         @map("organization_id")
  parentPartnerId    String                         @map("parent_partner_id")
  identityKind       WealthPartnerIdentityKind      @map("identity_kind")
  childContactId     String?                        @map("child_contact_id")
  childCompanyId     String?                        @map("child_company_id")
  childDisplayName   String                         @map("child_display_name")
  relationshipType   String                         @map("relationship_type")
  memberPartnerType  String?                        @map("member_partner_type")
  effectiveDate      DateTime                       @map("effective_date")
  status             WealthPartnerNetworkMemberStatus @default(active)
  notes              String?                        @db.Text
  isDeleted          Boolean                        @default(false) @map("is_deleted")
  deletedAt          DateTime?                      @map("deleted_at")
  deletedBy          String?                        @map("deleted_by")
  createdBy          String                         @map("created_by")
  modifiedBy         String                         @map("modified_by")
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parentPartner EnterpriseWealthPartner @relation(fields: [parentPartnerId], references: [id], onDelete: Cascade)

  @@index([organizationId, parentPartnerId, status], map: "ewpnm_org_parent_idx")
  @@index([organizationId, childContactId], map: "ewpnm_org_child_contact_idx")
  @@index([organizationId, childCompanyId], map: "ewpnm_org_child_company_idx")
  @@map("enterprise_wealth_partner_network_members")
}

model EnterpriseWealthPartnerCommission {
  id               String                              @id @default(cuid())
  organizationId   String                              @map("organization_id")
  wealthPartnerId  String                              @map("wealth_partner_id")
  code             String
  label            String
  productCode      String?                             @map("product_code")
  productLabel     String?                             @map("product_label")
  /// Product-wise | slab-wise structure payload
  structureKind    String                              @default("product") @map("structure_kind")
  slabsJson        Json?                               @map("slabs_json")
  ratePercent      Float?                              @map("rate_percent")
  rateBps          Float?                              @map("rate_bps")
  flatAmount       Float?                              @map("flat_amount")
  currencyCode     String                              @default("INR") @map("currency_code")
  payoutFrequency  WealthPartnerCommissionPayoutFrequency @default(on_disbursement) @map("payout_frequency")
  overrideRulesJson Json?                              @map("override_rules_json")
  effectiveFrom    DateTime?                           @map("effective_from")
  effectiveUntil   DateTime?                           @map("effective_until")
  status           RegistryStatus                      @default(active)
  enabled          Boolean                             @default(true)
  versionNumber    Int                                 @default(1) @map("version_number")
  notes            String?                             @db.Text
  isDeleted        Boolean                             @default(false) @map("is_deleted")
  deletedAt        DateTime?                           @map("deleted_at")
  deletedBy        String?                             @map("deleted_by")
  createdBy        String                              @map("created_by")
  modifiedBy       String                              @map("modified_by")
  createdAt        DateTime                            @default(now()) @map("created_at")
  updatedAt        DateTime                            @updatedAt @map("updated_at")

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  wealthPartner EnterpriseWealthPartner @relation(fields: [wealthPartnerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code], map: "ewpc_org_code_key")
  @@index([organizationId, wealthPartnerId, enabled], map: "ewpc_org_partner_idx")
  @@map("enterprise_wealth_partner_commissions")
}

model EnterpriseWealthPartnerBankAccount {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  wealthPartnerId String   @map("wealth_partner_id")
  accountName     String   @map("account_name")
  bankName        String   @map("bank_name")
  accountNumber   String   @map("account_number")
  ifsc            String
  accountType     String?  @map("account_type")
  isPrimary       Boolean  @default(false) @map("is_primary")
  enabled         Boolean  @default(true)
  notes           String?  @db.Text
  isDeleted       Boolean  @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")
  createdBy       String   @map("created_by")
  modifiedBy      String   @map("modified_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  wealthPartner EnterpriseWealthPartner @relation(fields: [wealthPartnerId], references: [id], onDelete: Cascade)

  @@index([organizationId, wealthPartnerId], map: "ewpba_org_partner_idx")
  @@map("enterprise_wealth_partner_bank_accounts")
}

model EnterpriseWealthPartnerActivity {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  wealthPartnerId String   @map("wealth_partner_id")
  activityType    String   @map("activity_type")
  title           String
  detail          String?  @db.Text
  payload         Json?
  actorUserId     String?  @map("actor_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  wealthPartner EnterpriseWealthPartner @relation(fields: [wealthPartnerId], references: [id], onDelete: Cascade)

  @@index([organizationId, wealthPartnerId, createdAt(sort: Desc)], map: "ewpa_org_partner_created_idx")
  @@map("enterprise_wealth_partner_activities")
}

