/// CO-ORG-001 — Organization seal (1:1 org).
model OrganizationSeal {
  id             String   @id @default(cuid())
  organizationId String   @unique @map("organization_id")
  lastUpdated    String?  @map("last_updated")
  version        String?  @default("")
  initials       String?  @default("")
  documentId     String?  @map("document_id")
  createdBy      String   @map("created_by")
  modifiedBy     String   @map("modified_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("organization_seals")
}

/// CO-ORG-001 — Organization-scoped document registry.
model OrganizationDocument {
  id                        String    @id @default(cuid())
  organizationId            String    @map("organization_id")
  clientRecordId            String?   @map("client_record_id")
  originalFilename          String    @map("original_filename")
  displayName               String    @map("display_name")
  categoryId                String    @map("category_id")
  documentTypeId            String    @map("document_type_id")
  documentTypeLabel         String    @map("document_type_label")
  mimeType                  String    @map("mime_type")
  fileSizeBytes             Int       @map("file_size_bytes")
  status                    String    @default("active")
  versionNumber             Int       @default(1) @map("version_number")
  tagsJson                  Json?     @map("tags_json")
  contentBytes              Bytes?    @map("content_bytes")
  versionsJson              Json      @default("[]") @map("versions_json")
  /// CO-CCC-001 — compliance metadata (OrganizationDocument remains binary SSOT)
  legalEntityId             String?   @map("legal_entity_id")
  repositoryKey             String?   @map("repository_key")
  financialYear             String?   @map("financial_year")
  isCurrentFinancialVersion Boolean   @default(false) @map("is_current_financial_version")
  effectiveDate             DateTime? @map("effective_date")
  expiryDate                DateTime? @map("expiry_date")
  approvalStatus            String    @default("draft") @map("approval_status")
  confidentiality           String    @default("internal")
  supersededByDocumentId    String?   @map("superseded_by_document_id")
  linkedPackageIdsJson      Json?     @map("linked_package_ids_json")
  uploadedBy                String    @map("uploaded_by")
  createdBy                 String    @map("created_by")
  modifiedBy                String    @map("modified_by")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  legalEntity  CccLegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  dispatchItems CccDispatchItem[]

  @@unique([organizationId, clientRecordId], map: "org_documents_org_client_key")
  @@index([organizationId, status], map: "org_documents_org_status_idx")
  @@index([organizationId, categoryId], map: "org_documents_org_category_idx")
  @@index([organizationId, repositoryKey], map: "org_documents_org_repository_idx")
  @@index([organizationId, legalEntityId], map: "org_documents_org_entity_idx")
  @@index([organizationId, financialYear], map: "org_documents_org_fy_idx")
  @@index([organizationId, approvalStatus], map: "org_documents_org_approval_idx")
  @@index([organizationId, expiryDate], map: "org_documents_org_expiry_idx")
  @@map("organization_documents")
}

/// CO-ORG-001 — Dynamic organization document template types.
model OrganizationDocumentTemplateType {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  typeCode       String   @map("type_code")
  label          String
  sortOrder      Int      @default(0) @map("sort_order")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdBy      String   @map("created_by")
  modifiedBy     String   @map("modified_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, typeCode], map: "org_doc_template_org_code_key")
  @@index([organizationId, isDeleted], map: "org_doc_template_org_deleted_idx")
  @@map("organization_document_template_types")
}

/// CO-ORG-001 — Organization MDM activity feed (domain ledger; dual-writes to EAR).
model OrganizationActivityEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  title          String
  description    String?  @db.Text
  eventType      String   @map("event_type")
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  actorUserId    String?  @map("actor_user_id")
  actorName      String?  @map("actor_name")
  occurredAt     DateTime @default(now()) @map("occurred_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt(sort: Desc)], map: "org_activity_org_occurred_idx")
  @@map("organization_activity_events")
}

/// CO-ORG-003 — Enterprise Activity Registry (append-only universal chronology SSOT).
/// Domain ledgers (Deal Timeline, ECIE conversation, Org MDM) remain authoritative for their
/// domains and emit into EAR. Cross-desk readers consume EAR only.
model EnterpriseActivityEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")

  eventKind      String   @map("event_kind")
  sourceSystem   String   @map("source_system")
  sourceEventId  String?  @map("source_event_id")

  title          String
  summary        String?  @db.Text
  payload        Json?

  opportunityId  String?  @map("opportunity_id")
  dealId         String?  @map("deal_id")
  contactId      String?  @map("contact_id")
  taskId         String?  @map("task_id")
  documentId     String?  @map("document_id")

  actorUserId    String?  @map("actor_user_id")
  actorName      String?  @map("actor_name")
  occurredAt     DateTime @map("occurred_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, sourceSystem, sourceEventId], map: "ear_org_source_uidx")
  @@index([organizationId, occurredAt(sort: Desc)], map: "ear_org_occurred_idx")
  @@index([organizationId, opportunityId, occurredAt(sort: Desc)], map: "ear_org_opp_occurred_idx")
  @@index([organizationId, dealId, occurredAt(sort: Desc)], map: "ear_org_deal_occurred_idx")
  @@index([organizationId, contactId, occurredAt(sort: Desc)], map: "ear_org_contact_occurred_idx")
  @@index([organizationId, eventKind, occurredAt(sort: Desc)], map: "ear_org_kind_occurred_idx")
  @@map("enterprise_activity_events")
}

/// CO-NOTIFICATION-001 — Enterprise Notification Engine (per-recipient delivery ledger).
/// Distinct from EAR chronology and ENCE outbound simulation.
model EnterpriseNotification {
  id                   String    @id @default(cuid())
  organizationId       String    @map("organization_id")

  eventType            String    @map("event_type")
  dedupeKey            String    @map("dedupe_key")
  sourceEventId        String    @map("source_event_id")
  sourceSystem         String    @map("source_system")

  title                String
  body                 String    @db.Text
