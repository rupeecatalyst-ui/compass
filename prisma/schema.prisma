// =============================================================================
// CO-ARCH-002-W1 ? Enterprise Deal Registry (Tier 3 transactional SSOT)
// F0 constitutional. Feature flags default OFF. No UI consumers in Wave 1.
// ARB amendments: Deal Snapshot, Append-Only Timeline, Deal Health reservation.
// CO-ARCH-003: Opportunity Registry schema is Plan Mode — see
// docs/co-arch-003/CO-ARCH-003-PHASE-1-OPPORTUNITY-SCHEMA-REVIEW.md (no migration yet).
// =============================================================================

enum DealProductFamily {
  lending
  mutual_fund
  insurance
  bonds
  pms
  other
}

enum DealLifecycleStatus {
  active
  on_hold
  won
  lost
  cancelled
  archived
}

enum DealOperationalStatus {
  on_track
  at_risk
  delayed
  completed
}

enum DealPriority {
  urgent
  high
  medium
  low
}

enum DealCounterpartyType {
  lender
  amc
  insurer
  issuer
  institution
  other
}

enum DealParticipantRole {
  primary_customer
  co_applicant
  guarantor
  nominee
  authorized_signatory
  other
}

enum DealDocumentLinkStatus {
  required
  requested
  received
  under_verification
  verified
  rejected
  expired
  waived
}

enum DealAssignmentRole {
  primary_owner
  relationship_manager
  source_owner
  credit_owner
  operations
  other
}

enum DealImportBatchStatus {
  dry_run
  pending
  running
  completed
  failed
  cancelled
}

// CO-ARCH-003 Phase 2A — Opportunity Registry + per-lender Deal FK
// ERD: docs/co-arch-003/CO-ARCH-003-PHASE-2A-ERD.md

enum OpportunityFulfilmentMode {
  exclusive
  additive
  policy_driven
}

enum OpportunityFulfilmentStatus {
  open
  partially_fulfilled
  fulfilled
  abandoned
}

enum OpportunityLifecycleStatus {
  /// CO-OPP-002 — discussion started; requirement not yet submitted (initial status)
  dialogue
  /// ADR-018 / CO-OPP-002 — Product + Required Amount saved
  requirement_captured
  /// CO-OPP-002 — documents / credit / processing
  in_progress
  /// CO-OPP-002 — at least one Deal created
  converted_to_deal
  /// CO-OPP-002 — requirement fulfilled (e.g. disbursement)
  completed
  on_hold
  lost
  cancelled
  /// @deprecated Historical only — never write for new Opportunities (CO-OPP-002). Do not migrate rows.
  draft
  /// @deprecated Historical synonym of in_progress — do not migrate rows.
  active
  /// @deprecated Historical synonym of completed — do not migrate rows.
  won
  archived
}

