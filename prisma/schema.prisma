  organizationId     String    @map("organization_id")
  opportunityId      String    @map("opportunity_id")
  opportunityNumber  String?   @map("opportunity_number")
  clientRecordId     String?   @map("client_record_id")
  loanFileId         String?   @map("loan_file_id")
  contactId          String?   @map("contact_id")
  customerId         String?   @map("customer_id")
  participantId      String?   @map("participant_id")
  lenderId           String?   @map("lender_id")
  documentScope      String    @default("applicant") @map("document_scope")
  typeRef            String    @map("type_ref")
  categoryLabel      String    @map("category_label")
  originalFilename   String    @map("original_filename")
  displayName        String    @map("display_name")
  mimeType           String    @map("mime_type")
  fileSizeBytes      Int       @map("file_size_bytes")
  status             String    @default("active")
  uploadSource       String?   @map("upload_source")
  uploadedBy         String    @map("uploaded_by")
  verifiedAt         DateTime? @map("verified_at")
