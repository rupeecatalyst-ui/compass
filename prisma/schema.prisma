generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations / introspect must use DIRECT_URL (5432). Pooler (6543) hangs migrate deploy.
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// Auth (Pilot Phase 1 ? live)
// =============================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ANALYST
  VIEWER
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  passwordHash       String         @map("password_hash")
  firstName          String         @map("first_name")
  lastName           String         @map("last_name")
  employeeId         String?        @unique @map("employee_id")
  mobile             String?        @map("mobile")
  department         String?        @map("department")
  avatarUrl          String?        @map("avatar_url")
  role               Role           @default(VIEWER)
  isActive           Boolean        @default(true) @map("is_active")
  mustChangePassword Boolean        @default(false) @map("must_change_password")
  createdById        String?        @map("created_by_id")
  reportingManagerId String?        @map("reporting_manager_id")
  eumUserId          String?        @unique @map("eum_user_id")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  refreshTokens      RefreshToken[]
  resetTokens        PasswordResetToken[]
  createdBy          User?          @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       User[]         @relation("UserCreatedBy")
  reportingManager   User?          @relation("UserReportsTo", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports      User[]         @relation("UserReportsTo")
  ecmContacts        EcmContact[]   @relation("EcmContactLinkedUser")

  @@index([reportingManagerId])
  @@index([createdById])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// =============================================================================
// CO-SPRINT-117 ? Phase 1B Enterprise Persistence
// Foundation + ECM (individuals) + Company Registry (legal entities)
// Approved: Single org ? REST ? Supabase Storage (docs CO-SPRINT-121)
// Excluded: EOLE (Phase 2A) ? Loan files hybrid JSONB (CO-SPRINT-118+)
// =============================================================================

enum EcmContactRole {
  customer
  employee
  lender_employee
  partner
  investor
  builder
  chartered_accountant
}

enum EcmContactStatus {
  provisional
  active
  complete
  verified
  archived
}

enum EcmPlatformAccess {
  no_access
  catalyst_one
  compass
  both
}

enum EcmContactRelationshipType {
  reports_to
  managed_by
  assistant_to
  legal_representative
  refers_to
}

enum EcmContactRelationshipStatus {
  active
  inactive
}

enum EcmAuditEntityType {
  contact
  contact_relationship
}

enum EcmCompanyStatus {
  active
  archived
}

enum EcmCompanyRelationRole {
  director
  promoter
  partner
  authorized_signatory
  employee
  cfo
  company_secretary
  proprietor
  shareholder
  other
}

/// CO-DOM-001 — Primary borrower on Opportunity (individual or company).
enum OpportunityPrimaryBorrowerKind {
  individual
  company
}

enum EcmCompanyLinkStatus {
  active
  inactive
}

/// Single organization pilot ? slug `rupee-catalyst` (see ENTERPRISE_PERSISTENCE_ORG_SLUG).
model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contacts           EcmContact[]
  relationships      EcmContactRelationship[]
  auditRefs          EcmContactAuditReference[]
  companies          EcmCompany[]
  companyLinks       EcmCompanyContactLink[]
  softDeleteRecords  EnterpriseSoftDeleteRecord[]
  softDeleteAudits   EnterpriseSoftDeleteAudit[]
  registryAuditEntries      EnterpriseRegistryAuditEntry[]
  registryAttachments       EnterpriseRegistryAttachment[]
  registryImportBatches     EnterpriseRegistryImportBatch[]
  referenceMasters          EnterpriseReferenceMaster[]
  productCategories         EnterpriseProductCategory[]
  productGroups             EnterpriseProductGroup[]
  products                  EnterpriseProduct[]
  documentTypes             EnterpriseDocumentType[]
  documentDefinitions       EnterpriseDocumentDefinition[]
  lenderCategories          EnterpriseLenderCategory[]
  lenders                   EnterpriseLender[]
  lenderPrograms            EnterpriseLenderProgram[]
  lenderContacts            EnterpriseLenderContact[]
  lenderDocuments           EnterpriseLenderDocument[]
  /// CO-ARCH-003 — Opportunity Registry
  enterpriseOpportunities              EnterpriseOpportunity[]
  enterpriseOpportunityNumberSequences EnterpriseOpportunityNumberSequence[]
  /// CO-ARCH-003 Phase 2B Sprint 1 — Invoice Party Master (Accounting)
  enterpriseInvoiceParties           EnterpriseInvoiceParty[]
  enterpriseAccountingGstRates       EnterpriseAccountingGstRate[]
  enterpriseAccountingInvoiceNumberSequences EnterpriseAccountingInvoiceNumberSequence[]
  enterpriseAccountingInvoices       EnterpriseAccountingInvoice[]
  enterpriseAccountingPayments       EnterpriseAccountingPayment[]
  enterpriseAccountingCreditNoteNumberSequences EnterpriseAccountingCreditNoteNumberSequence[]
  enterpriseAccountingCreditNotes    EnterpriseAccountingCreditNote[]
  /// CO-ARCH-002-W1 / CO-ARCH-003 — Enterprise Deal Registry (per-lender Deal)
  enterpriseDeals                    EnterpriseDeal[]
  enterpriseDealNumberSequences      EnterpriseDealNumberSequence[]
  enterpriseDealImportBatches        EnterpriseDealImportBatch[]
  enterpriseDealParticipants         EnterpriseDealParticipant[]
  enterpriseDealCounterpartyAssignments EnterpriseDealCounterpartyAssignment[]
  enterpriseDealDocumentLinks        EnterpriseDealDocumentLink[]
  enterpriseDealTasks                EnterpriseDealTask[]
  enterpriseDealActivities           EnterpriseDealActivity[]
  enterpriseDealNotes                EnterpriseDealNote[]
  enterpriseDealTimelineEvents       EnterpriseDealTimelineEvent[]
  enterpriseDealAssignments          EnterpriseDealAssignment[]
  enterpriseDealCommercialVersions   EnterpriseDealCommercialVersion[]
  enterpriseDealSnapshots            EnterpriseDealSnapshot[]
  enterpriseDealCommissionLinks      EnterpriseDealCommissionLink[]
  enterpriseDealAccountingLinks      EnterpriseDealAccountingLink[]
  enterpriseDealNotificationLinks    EnterpriseDealNotificationLink[]
  enterpriseDealIntelligenceLinks    EnterpriseDealIntelligenceLink[]
  enterpriseDealWorkflowBindings     EnterpriseDealWorkflowBinding[]
  postDisbursementSchedules          EnterprisePostDisbursementSchedule[]
  enterpriseAccountingCases          EnterpriseAccountingCase[]
  /// CO-ADMIN-004 — Production Reset run audit (immutable history)
  productionResetRuns                ProductionResetRun[]
  /// CO-PERF-001 — Enterprise Metrics Engine read models
  enterpriseMetricRuns               EnterpriseMetricRun[]
  enterpriseMetricSnapshots          EnterpriseMetricSnapshot[]
  /// CO-LEND-001 — Lender Self-Service Program Portal
  lenderProgramPortalInvites         LenderProgramPortalInvite[]
  lenderProgramPortalInviteProducts  LenderProgramPortalInviteProduct[]
  lenderProgramSubmissions           LenderProgramSubmission[]
  lenderProgramPortalAudits          LenderProgramPortalAudit[]
  lenderProgramDialogueThreads       LenderProgramDialogueThread[]
  lenderProgramDialogueMessages      LenderProgramDialogueMessage[]
  /// CO-DOC-002 — Durable Opportunity Document Registry (metadata + optional content)
  enterpriseTransactionDocuments     EnterpriseTransactionDocument[]
  /// CO-DOC-005 — Enterprise Document Package Registry (additive; migration pending approval)
  enterpriseDocumentPackages         EnterpriseDocumentPackage[]
  /// CO-WP-001 — Enterprise Wealth Partner Registry (additive; Contact/Company remain identity SSOT)
  enterpriseWealthPartners                 EnterpriseWealthPartner[]
  enterpriseWealthPartnerNetworkMembers    EnterpriseWealthPartnerNetworkMember[]
  enterpriseWealthPartnerCommissions       EnterpriseWealthPartnerCommission[]
  enterpriseWealthPartnerBankAccounts      EnterpriseWealthPartnerBankAccount[]
  enterpriseWealthPartnerActivities        EnterpriseWealthPartnerActivity[]
  /// CO-WP-ACCESS-001 — Wealth Partner Access & Entitlements
  partnerEntitlementTemplates              PartnerEntitlementTemplate[]
  partnerEntitlementProfiles               PartnerEntitlementProfile[]
  partnerTransactionEntitlements           PartnerTransactionEntitlement[]
  partnerEntitlementAudits                 PartnerEntitlementAudit[]
  /// CO-INV-001 — Enterprise Invitation Engine
  enterpriseInvitations                    EnterpriseInvitation[]
  enterpriseInvitationAudits               EnterpriseInvitationAudit[]
  enterpriseCommunicationConfigs           EnterpriseCommunicationConfig[]
  /// CO-ECC-001 — Enterprise Communication Center profiles
  enterpriseCommunicationProfiles          EnterpriseCommunicationProfile[]
  /// CO-VOICE-002 — ECIE conversation activity (transcripts; audio in Document Registry)
  enterpriseConversationActivities         EnterpriseConversationActivity[]
  /// CO-ORG-003 — Enterprise Activity Registry (universal operational chronology SSOT)
  enterpriseActivityEvents                 EnterpriseActivityEvent[]
  /// CO-NOTIFICATION-001 — Enterprise Notification Engine (in-app delivery SSOT)
  enterpriseNotifications                  EnterpriseNotification[]
  /// CO-UX-021 — Enterprise Business Notes (official business chronology notes)
  enterpriseBusinessNotes                  EnterpriseBusinessNote[]
  /// CO-ORG-001 — Enterprise Organization Workspace (durable backend)
  organizationWorkspaceProfile             OrganizationWorkspaceProfile?
  organizationWorkspaceSettings            OrganizationWorkspaceSettings?
  organizationBusinessConfig               OrganizationBusinessConfig?
  organizationSecurityConfig               OrganizationSecurityConfig?
  organizationDirectors                    OrganizationDirector[]
  organizationBankAccounts                 OrganizationBankAccount[]
  organizationDigitalSignatures            OrganizationDigitalSignature[]
  organizationSeal                         OrganizationSeal?
  organizationDocuments                    OrganizationDocument[]
  organizationDocumentTemplateTypes        OrganizationDocumentTemplateType[]
  organizationActivityEvents               OrganizationActivityEvent[]
  organizationAuditEntries                 OrganizationAuditEntry[]
  /// CO-HL-PROGRAM-001 — Product-scoped lender selection priority (does not mutate lender master)
  enterpriseProductLenderPriorities        EnterpriseProductLenderPriority[]
  /// CO-CCC-001 — Corporate Compliance Center
  cccLegalEntities                         CccLegalEntity[]
  cccInstitutionProfiles                   CccInstitutionProfile[]
  cccInstitutionRequirements               CccInstitutionRequirement[]
  cccDocumentPackageDefinitions            CccDocumentPackageDefinition[]
  cccDocumentPackageInstances              CccDocumentPackageInstance[]
  cccDispatches                            CccDispatch[]

  @@map("organizations")
}

/// CO-ORG-001 — Organization workspace company profile (1:1 org).
model OrganizationWorkspaceProfile {
  id                   String   @id @default(cuid())
  organizationId       String   @unique @map("organization_id")
  companyName          String   @map("company_name")
  legalEntityName      String?  @map("legal_entity_name")
  brandName            String   @map("brand_name")
  logoInitials         String?  @map("logo_initials")
  logoDocumentId       String?  @map("logo_document_id")
  gst                  String   @default("")
  pan                  String   @default("")
  cin                  String   @default("")
  msme                 String   @default("")
  incorporationDate    String?  @map("incorporation_date")
  incorporationDetails String?  @map("incorporation_details") @db.Text
  registeredAddress    String?  @map("registered_address") @db.Text
  corporateAddress     String?  @map("corporate_address") @db.Text
  website              String   @default("")
  phoneNumbersJson     Json     @default("[]") @map("phone_numbers_json")
  officialEmailsJson   Json     @default("[]") @map("official_emails_json")
  emailDomainsJson     Json     @default("[]") @map("email_domains_json")
  socialLinksJson      Json     @default("{}") @map("social_links_json")
  versionNumber        Int      @default(1) @map("version_number")
  createdBy            String   @map("created_by")
  modifiedBy           String   @map("modified_by")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("organization_workspace_profiles")
}

/// CO-ORG-001 — Organization workspace settings (1:1 org).
model OrganizationWorkspaceSettings {
  id                    String   @id @default(cuid())
  organizationId        String   @unique @map("organization_id")
  workingDaysJson       Json     @default("[]") @map("working_days_json")
  workingHoursJson      Json     @default("{}") @map("working_hours_json")
  holidayCalendarJson   Json     @default("[]") @map("holiday_calendar_json")
  financialYearStartMonth Int    @default(4) @map("financial_year_start_month")
  timeZone              String   @default("Asia/Kolkata") @map("time_zone")
  currency              String   @default("INR")
  numberFormat          String   @default("en-IN") @map("number_format")
  dateFormat            String   @default("dd/MM/yyyy") @map("date_format")
  versionNumber         Int      @default(1) @map("version_number")
  createdBy             String   @map("created_by")
  modifiedBy            String   @map("modified_by")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("organization_workspace_settings")
}

