  @@index([organizationId, lenderId], map: "edeal_org_lender_idx")
  @@index([organizationId, invoicePartyContactId], map: "edeal_org_commission_payee_contact_idx")
  @@index([organizationId, invoicePartyId], map: "edeal_org_commission_accounting_payee_idx")
