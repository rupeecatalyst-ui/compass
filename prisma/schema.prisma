// =============================================================================
// CO-WP-001 — Enterprise Wealth Partner Registry
// Additive module. Contact / Company remain master identity SSOTs.
// Identity IDs stored without Prisma relations on ECM models (zero ECM schema churn).
// =============================================================================

enum WealthPartnerLifecycleStatus {
  draft
  onboarding
  active
  suspended
  retired
}

enum WealthPartnerOperationalStatus {
  inactive
  active
  restricted
}

enum WealthPartnerIdentityKind {
  contact
  company
}

enum WealthPartnerNetworkMemberStatus {
  active
  inactive
  ended
}

enum WealthPartnerCommissionPayoutFrequency {
  monthly
  quarterly
  half_yearly
  annually
  on_disbursement
  other
}

/// Immutable codes e.g. WPT000001. Business relationship on top of Contact or Company.
model EnterpriseWealthPartner {
  id                String                         @id @default(cuid())
  organizationId    String                         @map("organization_id")
  code              String
  displayName       String                         @map("display_name")
  /// Wealth Partner Type (business relationship) — not profession.
  partnerType       String                         @map("partner_type")
  identityKind      WealthPartnerIdentityKind      @map("identity_kind")
  /// Exactly one of contactId / companyId required (application-enforced).
  contactId         String?                        @map("contact_id")
  companyId         String?                        @map("company_id")
  identityLabel     String?                        @map("identity_label")
  lifecycleStatus   WealthPartnerLifecycleStatus   @default(onboarding) @map("lifecycle_status")
  operationalStatus WealthPartnerOperationalStatus @default(active) @map("operational_status")
  pan               String?
  gstin             String?
  email             String?
  mobile            String?
  cityLabel         String?                        @map("city_label")
  stateLabel        String?                        @map("state_label")
  website           String?
  notes             String?                        @db.Text
  profileJson       Json?                          @map("profile_json")
  complianceJson    Json?                          @map("compliance_json")
  /// CO-OPP-003 — Commercial Profile (% of Rupee Catalyst revenue by Participation Role).
  commercialReferralSharePercent       Float?      @map("commercial_referral_share_percent")
  commercialSoleExecutorSharePercent   Float?      @map("commercial_sole_executor_share_percent")
  commercialJointExecutorSharePercent  Float?      @map("commercial_joint_executor_share_percent")
  commercialEffectiveFrom              DateTime?   @map("commercial_effective_from")
  commercialStatus                     String      @default("active") @map("commercial_status")
  sortOrder         Int                            @default(0) @map("sort_order")
  status            RegistryStatus                 @default(active)
  enabled           Boolean                        @default(true)
  versionNumber     Int                            @default(1) @map("version_number")
  effectiveFrom     DateTime?                      @map("effective_from")
  effectiveUntil    DateTime?                      @map("effective_until")
  isDeleted         Boolean                        @default(false) @map("is_deleted")
  deletedAt         DateTime?                      @map("deleted_at")
  deletedBy         String?                        @map("deleted_by")
  deletionReason    String?                        @map("deletion_reason") @db.Text
  approvalStatus    RegistryApprovalStatus         @default(none) @map("approval_status")
  approvedBy        String?                        @map("approved_by")
  approvedAt        DateTime?                      @map("approved_at")
  createdBy         String                         @map("created_by")
  modifiedBy        String                         @map("modified_by")
  createdAt         DateTime                       @default(now()) @map("created_at")
  updatedAt         DateTime                       @updatedAt @map("updated_at")

  organization   Organization                          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  networkMembers EnterpriseWealthPartnerNetworkMember[]
  commissions    EnterpriseWealthPartnerCommission[]
  bankAccounts   EnterpriseWealthPartnerBankAccount[]
  activities     EnterpriseWealthPartnerActivity[]
  /// CO-WP-ACCESS-001
  entitlementProfile          PartnerEntitlementProfile?
  transactionEntitlements     PartnerTransactionEntitlement[]
  entitlementAudits           PartnerEntitlementAudit[]

  @@unique([organizationId, code], map: "ewp_org_code_key")
  @@index([organizationId, partnerType, isDeleted], map: "ewp_org_type_idx")
  @@index([organizationId, contactId], map: "ewp_org_contact_idx")
  @@index([organizationId, companyId], map: "ewp_org_company_idx")
  @@index([organizationId, isDeleted, updatedAt(sort: Desc)], map: "ewp_org_list_idx")
  @@map("enterprise_wealth_partners")
}

/// Network relationship only — never duplicates Contact/Company masters.
model EnterpriseWealthPartnerNetworkMember {
  id                 String                         @id @default(cuid())
  organizationId     String                         @map("organization_id")
  parentPartnerId    String                         @map("parent_partner_id")
  identityKind       WealthPartnerIdentityKind      @map("identity_kind")
  childContactId     String?                        @map("child_contact_id")
  childCompanyId     String?                        @map("child_company_id")
  childDisplayName   String                         @map("child_display_name")
  relationshipType   String                         @map("relationship_type")
  memberPartnerType  String?                        @map("member_partner_type")
  effectiveDate      DateTime                       @map("effective_date")
  status             WealthPartnerNetworkMemberStatus @default(active)
  notes              String?                        @db.Text
  isDeleted          Boolean                        @default(false) @map("is_deleted")
  deletedAt          DateTime?                      @map("deleted_at")
  deletedBy          String?                        @map("deleted_by")
  createdBy          String                         @map("created_by")
  modifiedBy         String                         @map("modified_by")
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parentPartner EnterpriseWealthPartner @relation(fields: [parentPartnerId], references: [id], onDelete: Cascade)

  @@index([organizationId, parentPartnerId, status], map: "ewpnm_org_parent_idx")
  @@index([organizationId, childContactId], map: "ewpnm_org_child_contact_idx")
  @@index([organizationId, childCompanyId], map: "ewpnm_org_child_company_idx")
  @@map("enterprise_wealth_partner_network_members")
}

