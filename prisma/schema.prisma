// =============================================================================
// CO-INV-001 — Enterprise Invitation Engine (reusable; Wealth Partner first)
// =============================================================================

enum EnterpriseInvitationStatus {
  draft
  link_generated
  invite_sent
  activated
  expired
  cancelled
}

enum EnterpriseInvitationInviteeKind {
  wealth_partner
  internal_employee
  customer
  lender_user
  channel_partner
  referral_partner
}

enum EnterpriseInvitationAuditEvent {
  link_generated
  invite_sent
  resent
  activated
  cancelled
  expired
}

/// Org-scoped transactional email sender — never hardcode From: in application logic.
model EnterpriseCommunicationConfig {
  id                       String   @id @default(cuid())
  organizationId           String   @unique @map("organization_id")
  defaultSenderDisplayName String   @map("default_sender_display_name")
  defaultSenderEmail       String   @map("default_sender_email")
  supportContactEmail      String   @map("support_contact_email")
  supportContactPhone      String?  @map("support_contact_phone")
  modifiedBy               String   @map("modified_by")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("enterprise_communication_configs")
}

/// CO-ECC-001 — Named Communication Profiles (CHANNEL_PARTNERS, CUSTOMERS, …).
model EnterpriseCommunicationProfile {
  id                     String   @id @default(cuid())
  organizationId         String   @map("organization_id")
  profileCode            String   @map("profile_code")
  displayName            String   @map("display_name")
  senderEmail            String   @map("sender_email")
  replyToEmail           String?  @map("reply_to_email")
  smtpProvider           String   @default("none") @map("smtp_provider")
  smtpHost               String?  @map("smtp_host")
  smtpPort               Int?     @map("smtp_port")
  smtpUsername           String?  @map("smtp_username")
  /// Opaque credential storage — never expose via API responses.
  smtpPasswordEnc        String?  @map("smtp_password_enc") @db.Text
  signature              String?  @db.Text
  footer                 String?  @db.Text
  logoUrl                String?  @map("logo_url")
  supportEmail           String?  @map("support_email")
  supportPhone           String?  @map("support_phone")
  usedForJson            Json?    @map("used_for_json")
  active                 Boolean  @default(true)
  modifiedBy             String   @map("modified_by")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, profileCode], map: "ecp_org_code_uidx")
  @@index([organizationId, active], map: "ecp_org_active_idx")
  @@map("enterprise_communication_profiles")
}

model EnterpriseInvitation {
  id                   String                           @id @default(cuid())
  organizationId       String                           @map("organization_id")
  inviteeKind          EnterpriseInvitationInviteeKind  @map("invitee_kind")
  entityId             String                           @map("entity_id")
  entityLabel          String?                          @map("entity_label")
  recipientEmail       String                           @map("recipient_email")
  recipientName        String                           @map("recipient_name")
  status               EnterpriseInvitationStatus       @default(draft)
  /// Public activation token (opaque). Never log full value after issue.
  token                String                           @unique
  tokenHash            String                           @map("token_hash")
  expiresAt            DateTime                         @map("expires_at")
  activatedAt          DateTime?                        @map("activated_at")
  cancelledAt          DateTime?                        @map("cancelled_at")
  cancelledBy          String?                          @map("cancelled_by")
  maxUses              Int                              @default(1) @map("max_uses")
  useCount             Int                              @default(0) @map("use_count")
  previousInvitationId String?                          @map("previous_invitation_id")
  redirectTarget       String                           @default("catalyst_connect") @map("redirect_target")
  customRedirectUrl    String?                          @map("custom_redirect_url")
  lastSentAt           DateTime?                        @map("last_sent_at")
  deliveryMode         String?                          @map("delivery_mode")
  createdBy            String                           @map("created_by")
  modifiedBy           String                           @map("modified_by")
  createdAt            DateTime                         @default(now()) @map("created_at")
  updatedAt            DateTime                         @updatedAt @map("updated_at")

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  audits       EnterpriseInvitationAudit[]

  @@index([organizationId, inviteeKind, entityId, status], map: "einv_org_kind_entity_status_idx")
  @@index([organizationId, expiresAt], map: "einv_org_expires_idx")
  @@index([organizationId, recipientEmail], map: "einv_org_email_idx")
  @@map("enterprise_invitations")
}

model EnterpriseInvitationAudit {
  id             String                         @id @default(cuid())
  organizationId String                         @map("organization_id")
  invitationId   String                         @map("invitation_id")
  eventType      EnterpriseInvitationAuditEvent @map("event_type")
  actorUserId    String?                        @map("actor_user_id")
  actorLabel     String                         @map("actor_label")
  detail         String?                        @db.Text
  createdAt      DateTime                       @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitation   EnterpriseInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([organizationId, invitationId, createdAt(sort: Desc)], map: "einv_audit_org_inv_idx")
  @@map("enterprise_invitation_audits")
}

// =============================================================================
// CO-WP-ACCESS-001 — Wealth Partner Access & Entitlements (Catalyst One SSOT)
// =============================================================================

/// Configurable entitlement templates (Referral / Joint / Solo defaults — editable).
model PartnerEntitlementTemplate {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
