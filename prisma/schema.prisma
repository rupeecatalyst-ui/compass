enum OpportunityFulfilmentMode {
  exclusive
  additive
  policy_driven
}

enum OpportunityFulfilmentStatus {
  open
  partially_fulfilled
  fulfilled
  abandoned
}

enum OpportunityLifecycleStatus {
  /// CO-OPP-002 — discussion started; requirement not yet submitted (initial status)
  dialogue
  /// ADR-018 / CO-OPP-002 — Product + Required Amount saved
  requirement_captured
  /// CO-OPP-002 — documents / credit / processing
  in_progress
  /// CO-OPP-002 — at least one Deal created
  converted_to_deal
  /// CO-OPP-002 — requirement fulfilled (e.g. disbursement)
  completed
  on_hold
  lost
  cancelled
  /// @deprecated Historical only — never write for new Opportunities (CO-OPP-002). Do not migrate rows.
  draft
  /// @deprecated Historical synonym of in_progress — do not migrate rows.
  active
  /// @deprecated Historical synonym of completed — do not migrate rows.
  won
  archived
}

