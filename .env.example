# When mode=prisma, Product Master / Categories / Groups require migrations + Seed / Sync Catalog.
# CO-ADMIN-006: Product Registry APIs fail closed until ENTERPRISE_PERSISTENCE_MODE=prisma
# and NEXT_PUBLIC_ENTERPRISE_PERSISTENCE_MODE=prisma are set.
ENTERPRISE_MASTERS_DUAL_READ=true
# I6a — Tier 1 picker port swap (set true to use Reference Master as runtime SSOT; reversible).
# REFERENCE_MASTER_PORT_RUNTIME=false
# NEXT_PUBLIC_REFERENCE_MASTER_PORT_RUNTIME=false
# I6b — Tier 2 picker port swap (product / lender / document registry ports; default OFF).
# TIER2_REGISTRY_PORT_RUNTIME=false
# NEXT_PUBLIC_TIER2_REGISTRY_PORT_RUNTIME=false
# -----------------------------------------------------------------------------
# CO-ARCH-002 / CO-P0-001 — Enterprise Deal Registry
# When ENTERPRISE_PERSISTENCE_MODE=prisma (and NEXT_PUBLIC mirror), API + Dual-Write +
# Port Runtime DEFAULT ON unless explicitly set false (Wave 6 rollback).
# Always set NEXT_PUBLIC_* on Vercel so the browser dual-writes and My Deals reads DB.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ENTERPRISE_PERSISTENCE_MODE=prisma
# DEAL_REGISTRY_API_ENABLED=true
# NEXT_PUBLIC_DEAL_REGISTRY_API_ENABLED=true
# DEAL_REGISTRY_DUAL_WRITE=true
# NEXT_PUBLIC_DEAL_REGISTRY_DUAL_WRITE=true
# DEAL_REGISTRY_PORT_RUNTIME=true
# NEXT_PUBLIC_DEAL_REGISTRY_PORT_RUNTIME=true
# Optional soak: DEAL_REGISTRY_SHADOW_READ=true
# Explicit rollback Soft Go-Live (idle):
# DEAL_REGISTRY_API_ENABLED=false
# NEXT_PUBLIC_DEAL_REGISTRY_API_ENABLED=false
# DEAL_REGISTRY_DUAL_WRITE=false
# NEXT_PUBLIC_DEAL_REGISTRY_DUAL_WRITE=false
# DEAL_REGISTRY_PORT_RUNTIME=false
# NEXT_PUBLIC_DEAL_REGISTRY_PORT_RUNTIME=false
# Wave 5 consumers — under prisma DEFAULT ON (unset). Explicit false = rollback only.
# DEAL_REGISTRY_CONSUMER_OPPORTUNITY=true
# NEXT_PUBLIC_DEAL_REGISTRY_CONSUMER_OPPORTUNITY=true
# DEAL_REGISTRY_CONSUMER_LOAN_WORKSPACE=true
# NEXT_PUBLIC_DEAL_REGISTRY_CONSUMER_LOAN_WORKSPACE=true
# DEAL_REGISTRY_CONSUMER_CUSTOMER_360=true
# NEXT_PUBLIC_DEAL_REGISTRY_CONSUMER_CUSTOMER_360=true
# DEAL_REGISTRY_CONSUMER_DOCUMENTS=true
# NEXT_PUBLIC_DEAL_REGISTRY_CONSUMER_DOCUMENTS=true
# DEAL_REGISTRY_CONSUMER_TASKS=true
# NEXT_PUBLIC_DEAL_REGISTRY_CONSUMER_TASKS=true
# DEAL_REGISTRY_CONSUMER_ACTIVITIES=true
# NEXT_PUBLIC_DEAL_REGISTRY_CONSUMER_ACTIVITIES=true
# DEAL_REGISTRY_CONSUMER_CHANAKYA_RADAR=true
# NEXT_PUBLIC_DEAL_REGISTRY_CONSUMER_CHANAKYA_RADAR=true
# CO-P0-006 Wave 1 — New Deal create requires Postgres success (DEFAULT ON under prisma).
# Explicit false = emergency rollback to localStorage-primary create only.
# DEAL_REGISTRY_PRIMARY_WRITE=true
# NEXT_PUBLIC_DEAL_REGISTRY_PRIMARY_WRITE=true
# DEAL_REGISTRY_PRIMARY_WRITE=false
# NEXT_PUBLIC_DEAL_REGISTRY_PRIMARY_WRITE=false
# DEAL_REGISTRY_IMPORT_ENABLED=false
# CO-STAB-002 — Hard-stop LoanFile localStorage durable writes (optional explicit).
# When Registry is operational, writers already skip localStorage (projection-only).
# DEAL_REGISTRY_BLOCK_LOCAL_WRITE=true
# NEXT_PUBLIC_DEAL_REGISTRY_BLOCK_LOCAL_WRITE=true
# Soft Go-Live emergency allow local writes only when Registry flags are also rolled back:
# DEAL_REGISTRY_BLOCK_LOCAL_WRITE=false
# NEXT_PUBLIC_DEAL_REGISTRY_BLOCK_LOCAL_WRITE=false
# Data integrity audit: node --env-file=.env.local scripts/co-stab-002-data-integrity-audit.mjs
# CO-CERT-005 — Production Certification Toolkit (never prints secrets):
#   npm run cert:env
#   npm run cert:routes
#   npm run cert:integrity
#   npm run cert:migrations
#   npm run cert:production
# CO-ARCH-003 Phase 2A — Opportunity Registry API
# Auto-on when Deal primary write is ON under prisma; explicit false = force off.
# OPPORTUNITY_REGISTRY_API_ENABLED=true
# NEXT_PUBLIC_OPPORTUNITY_REGISTRY_API_ENABLED=true
# OPPORTUNITY_REGISTRY_API_ENABLED=false
# NEXT_PUBLIC_OPPORTUNITY_REGISTRY_API_ENABLED=false
# Verify: npm run verify:co-arch-003-p2a
# Backfill: npm run backfill:co-arch-003-p2a
# Integrity / cutover gate (fails prisma builds if SSOT not operational):
#   npm run verify:deal-registry
# Docs: docs/incidents/CO-P0-002-ENTERPRISE-DEAL-OPERATIONAL-CUTOVER.md
# Phase A = implementation · Phase B = operational cutover · Phase C = legacy decommission
# Rollback: docs/co-arch-002/CO-ARCH-002-WAVE-6-ROLLBACK-RUNBOOK.md
# Optional explicit tier: local | pilot | production (Vercel sets pilot/production automatically)
# CATALYST_DEPLOYMENT_TIER=local
# Demo business seeds run ONLY when NODE_ENV=development, tier=local, mode=memory.
# CATALYST_DEMO_SEEDS_ENABLED is baked at build time — always false on Vercel.

# -----------------------------------------------------------------------------
# CO-OPS-001 — Administrator Build Information (optional overrides)
# next.config.ts bakes these at build from package.json + git / Vercel git metadata.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_VERSION=0.9.0-internal
# NEXT_PUBLIC_BUILD_NUMBER=1
# NEXT_PUBLIC_GIT_COMMIT_SHA=
# NEXT_PUBLIC_GIT_BRANCH=
# NEXT_PUBLIC_GIT_COMMIT_TIMESTAMP=
# NEXT_PUBLIC_BUILD_TIMESTAMP=
# NEXT_PUBLIC_DEPLOYMENT_TIMESTAMP=
# NEXT_PUBLIC_CATALYST_DEPLOYMENT_ENV=Local
# Values: Local | Preview | Production

# Frontend (Next.js / Vercel)
NEXT_PUBLIC_APP_NAME=COMPASS
# Set to the public site URL (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Leave empty on Vercel (same-origin App Router /api).
# Local dual-server (Express): http://localhost:4000
NEXT_PUBLIC_API_URL=

# Auth / API (required — CO-STAB-001 fail-closed; no insecure defaults)
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CO-ARCH-009 — Show Error Boundary exception messages on certification / preview builds.
# Leave unset in Production. Development always surfaces details.
# NEXT_PUBLIC_CERTIFICATION_ERROR_DETAILS=true

# Demo auth ONLY when DATABASE_URL is unset (local). Forbidden in production without DB.
# Certification credentials must be supplied via env — never commit passwords.
# DEMO_AUTH_ENABLED=true
# DEMO_AUTH_EMAIL=admin@compass.com
# DEMO_AUTH_PASSWORD=

# Prisma seed bootstrap Super Admin (required when running prisma db seed)
# BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@rupeecatalyst.com
# BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# Verification / smoke scripts (never hardcode in scripts)
# VERIFY_ADMIN_EMAIL=
# VERIFY_ADMIN_PASSWORD=
# SMOKE_EMAIL=
# SMOKE_PASSWORD=

# Express backend only (not used by Vercel Next deploy)
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# PostgreSQL (Prisma) — paste from Supabase → Catalyst One Platform → Database
# Prefer secrets in .env.local (not committed).
#
# CO-QA-005 — Runtime uses DATABASE_URL (Supabase pooler :6543 + pgbouncer=true).
# Migrations use DIRECT_URL (:5432 session). For Vercel serverless, keep the
# pooler URL and add connection_limit (start at 1–5) so instances do not exhaust
# the pool. Example:
#   DATABASE_URL=postgresql://...@...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10
#   DIRECT_URL=postgresql://...@...pooler.supabase.com:5432/postgres
# -----------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# -----------------------------------------------------------------------------
# CO-ADMIN-004 — Production Reset & Demo Data Cleanup Wizard
# Default OFF. Super Administrator only. Never enable casually in production.
# -----------------------------------------------------------------------------
# CO-PERF-001 — optional nightly metrics cron bearer secret
