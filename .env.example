# -----------------------------------------------------------------------------
# CO-INV-001 — Enterprise Invitation Engine / transactional sender
# Prefer Administration Communication Config (DB). Env overrides seed defaults.
# Do not hardcode sender addresses in application code.
# -----------------------------------------------------------------------------
# ENTERPRISE_TRANSACTIONAL_FROM_EMAIL=champion@rupeecatalyst.com
# ENTERPRISE_TRANSACTIONAL_FROM_NAME=Rupee Catalyst
# ENTERPRISE_SUPPORT_EMAIL=champion@rupeecatalyst.com
# ENTERPRISE_SUPPORT_PHONE=+91 98219 84181
# CO-C1-OPERATIONAL-EMAIL-001B — CUSTOMERS SMTP secret (Hostinger). Server-side only — never commit.
# ECC_CUSTOMERS_SMTP_PASSWORD=
# CO-C1-COMMUNICATION-002 — Universal inbound transaction email (Hostinger IMAP). Server-side only.
# Non-secret IMAP settings (host/port/user/mailbox/enabled/domains) are managed in Admin →
# Enterprise Communication → Incoming Email Server. Password remains host env only:
# INBOUND_EMAIL_ENABLED=true
# INBOUND_EMAIL_IMAP_HOST=imap.hostinger.com
# INBOUND_EMAIL_IMAP_PORT=993
# INBOUND_EMAIL_IMAP_USER=connect@rupeecatalyst.com
# INBOUND_EMAIL_IMAP_PASSWORD=
# INBOUND_EMAIL_MAILBOX=INBOX
# INBOUND_EMAIL_INTERNAL_DOMAINS=rupeecatalyst.com
# Cron auth (separate from IMAP password): POST /api/cron/inbound-email  Authorization: Bearer $CRON_SECRET
# CRON_SECRET=
# CO-WP-102 — Wealth Partner App origins allowed to call /api/partner/**
# PARTNER_APP_ORIGINS=https://wealth-partner-app.vercel.app,http://localhost:5173
# NEXT_PUBLIC_WEALTH_PARTNER_APP_URL=https://wealth-partner-app.vercel.app

# -----------------------------------------------------------------------------
# CO-AI-G2-W1 — Enterprise AI Orchestrator Shadow Mode
# Default OFF. When true, silent parallel reasoning capture runs after live SARATHI
# turns. Customer-facing text is NEVER replaced. Do not enable in production
# customer traffic without Product Owner approval.
# -----------------------------------------------------------------------------
# EAO_SHADOW_MODE_ENABLED=false

# -----------------------------------------------------------------------------
# CO-MARKETING-MKT-02 — Google Sheets Marketing Data Source (server-only)
# Raw audience SSOT remains in Google Drive/Sheets. Do NOT mirror into Supabase.
#
# ENTERPRISE_MARKETING_SHEETS_MODE=
#   fixture  — controlled in-memory tabs (default when unset — Command Center operational)
#   off      — Sheets READ disabled
#   live     — Google Sheets API via service account (readonly)
#
# Never enable campaign send / audience import / handoff via these flags.
# -----------------------------------------------------------------------------
# ENTERPRISE_MARKETING_SHEETS_MODE=fixture
# MARKETING_SHEETS_DEFAULT_SPREADSHEET_ID=
# MARKETING_SHEETS_DEFAULT_DISPLAY_NAME=Marketing Master Database
# MARKETING_SHEETS_DEFAULT_ORG_ID=default
#
# Live mode only (never commit real keys; never NEXT_PUBLIC_*):
# GOOGLE_SHEETS_CLIENT_EMAIL=
# GOOGLE_SHEETS_PRIVATE_KEY=
# Share the target Google Sheet with the service account email (Viewer).

# -----------------------------------------------------------------------------
# CO-MARKETING-MKT-07 — Email Delivery Provider (server-only)
# Default dry_run — validates + records delivery intent; NO external send.
#
# ENTERPRISE_MARKETING_EMAIL_MODE=
#   off      — refuse all email delivery port calls
#   dry_run  — safe provider (default for MKT-07)
#   live     — requires EXECUTION_ENABLED + PROVIDER_CONNECT + PO approval
#
# Never expose provider secrets via NEXT_PUBLIC_* or campaign records.
# -----------------------------------------------------------------------------
# ENTERPRISE_MARKETING_EMAIL_MODE=dry_run
# ENTERPRISE_MARKETING_RESEND_API_KEY=
# ENTERPRISE_MARKETING_SENDGRID_API_KEY=
# ENTERPRISE_MARKETING_SES_ACCESS_KEY_ID=
# ENTERPRISE_MARKETING_SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# CO-MARKETING-MKT-09 — WhatsApp Delivery Provider (server-only)
# Default dry_run — template-only validation + records; NO WhatsApp infrastructure.
#
# ENTERPRISE_MARKETING_WHATSAPP_MODE=
#   off      — refuse WhatsApp delivery port
#   dry_run  — safe provider (default for MKT-09)
#   live     — requires EXECUTION_ENABLED + PROVIDER_CONNECT + PO approval
#
# Free-form bulk messaging is forbidden. Approved templates only.
# Never expose provider secrets via NEXT_PUBLIC_* or campaign records.
# -----------------------------------------------------------------------------
# ENTERPRISE_MARKETING_WHATSAPP_MODE=dry_run
# ENTERPRISE_MARKETING_WHATSAPP_META_TOKEN=
# ENTERPRISE_MARKETING_WHATSAPP_TWILIO_AUTH_TOKEN=
# ENTERPRISE_MARKETING_WHATSAPP_GUPSHUP_API_KEY=

# -----------------------------------------------------------------------------
# CO-MARKETING-MKT-11 — Qualification handoff (server-only)
# Explicit QUALIFIED handoff only. Default fixture identity (no live ECM writes).
#
# ENTERPRISE_MARKETING_HANDOFF_MODE=
#   fixture  — isolated identity + Dialogue Opportunity stubs (default)
#   live     — ECM Contact match/create + Opportunity Registry Dialogue create
#
# Mass conversion is never enabled. No Lead entity.
# -----------------------------------------------------------------------------
# ENTERPRISE_MARKETING_HANDOFF_MODE=fixture

